# Copy to .env and fill in. Every value is server-only: none may be prefixed
# NEXT_PUBLIC_ or referenced from a page.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...      # the SECRET key, not the publishable one
TELEGRAM_BOT_TOKEN=1234567890:AA...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_WEBHOOK_SECRET=...                  # any long random string
VERCEL_TOKEN=...                             # deploy automation only
